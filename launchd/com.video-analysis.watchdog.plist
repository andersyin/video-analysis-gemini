<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.video-analysis.watchdog</string>
    <!-- Template only. bash launchd/install.sh writes the live copy
         under ~/Library/LaunchAgents with real PROJECT_ROOT and MEDIA_DIR. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/absolute/path/to/video-analysis-gemini/launchd/watchdog-wrapper.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MEDIA_DIR</key>
        <string>/absolute/path/to/Media</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/video-analysis-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/video-analysis-watchdog.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
