# Copy to local.env (gitignored) or export these in your shell.
# Do not sed-replace committed scripts.

# Required for L1 batch, audit scripts, and the launchd watchdog.
MEDIA_DIR=/path/to/Media

# Optional. Watchdog heartbeat directory. Unset → /tmp.
# KB_BASE=/path/to/kb

# Optional. Override the default six-account L1 batch list (space-separated).
# L1_ACCOUNTS="AccountA AccountB"
